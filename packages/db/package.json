{
  "name": "@kori/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test --test-isolation=none dist/**/*.test.js",
    "typecheck": "tsc -b --pretty false",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "npm run build && node dist/seed.js"
  },
  "dependencies": {
    "@kori/shared": "0.1.0",
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.44.5",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.8.3"
  }
}
