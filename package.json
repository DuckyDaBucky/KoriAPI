{
  "name": "koriapi",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @kori/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @kori/db",
    "db:migrate": "npm run db:migrate --workspace @kori/db",
    "db:push": "npm run db:push --workspace @kori/db",
    "db:seed": "npm run db:seed --workspace @kori/db"
  }
}
